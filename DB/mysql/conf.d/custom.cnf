[mysqld]
# General settings
skip-name-resolve
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock

# Performance tuning
max_connections = 150
key_buffer_size = 32M
max_allowed_packet = 16M
table_open_cache = 400
sort_buffer_size = 4M
read_buffer_size = 4M
read_rnd_buffer_size = 8M
join_buffer_size = 8M
query_cache_limit = 1M
query_cache_size = 32M
innodb_buffer_pool_size = 2G
innodb_log_file_size = 512M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_thread_concurrency = 4

# Logging
log_error = /var/log/mysql/error.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2


#Ce fichier de configuration est optimisé pour une utilisation de MySQL avec une base de données 
#qui pourrait avoir des requêtes complexes et une charge importante. 
#Il ajuste les buffers, les caches, et les journaux pour améliorer les performances, 
#tout en activant la journalisation des erreurs et des requêtes lentes pour faciliter le diagnostic. 
#Les paramètres InnoDB sont optimisés pour une utilisation intensive des bases de données avec une importante mise en cache des données. 
#Les paramètres des connexions et des fichiers de log sont également ajustés pour une meilleure gestion des ressources et une surveillance des performances.